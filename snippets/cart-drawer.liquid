<!-- Cart Drawer Overlay -->
<div class="cart-drawer-overlay" id="cartOverlay"></div>

<!-- Slide-out Cart Drawer -->
<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <div class="cart-drawer-header">
    <div class="cart-drawer-title">🛒 Your Cart</div>
    <button type="button" class="cart-close-btn" id="closeCartBtn" aria-label="Close cart">✕</button>
  </div>

  <div class="cart-drawer-body" id="cartDrawerItems">
    <!-- Populated dynamically via theme.js -->
  </div>

  <div class="cart-drawer-footer">
    <div style="background: #eefbf9; border: 2px dashed var(--color-teal-primary); border-radius: var(--border-radius-sm); padding: 8px 12px; margin-bottom: 16px; font-family: var(--font-fun); font-size: 0.85rem; color: var(--color-teal-dark); font-weight: 700; text-align: center;">
      🎉 You qualify for FREE Tracked Shipping!
    </div>

    <div class="cart-subtotal-row">
      <span>Subtotal:</span>
      <span id="cartSubtotalAmount">$24.99</span>
    </div>

    <button type="button" class="btn-cartoon btn-cartoon-pink" style="width: 100%; font-size: 1.15rem;" onclick="alert('Proceeding to Shopify Secure Checkout!')">
      🔒 Secure Checkout
    </button>
  </div>
</div>
