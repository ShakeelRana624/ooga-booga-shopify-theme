<section class="psd-section psd-section-cinema" id="cinema-hero" aria-label="{{ section.settings.title | default: 'Suburban Jungle Cinema' }}">
  <!-- Multi-plane parallax background -->
  <div class="s1-layer-bg" id="s1LayerBg"></div>
  <div class="s1-ambient-glow"></div>

  <!-- Top Announcement Badge -->
  <div class="s1-overlay-header">
    <span class="s1-vintage-pill">★ NOW SHOWING IN TECHNICOLOR ★</span>
  </div>

  <!-- Video Stage (Embedded precisely within carved bamboo frame cutout) -->
  <div class="s1-video-stage">
    <video 
      id="cinemaVideo" 
      class="s1-video-player"
      src="{{ 'videos/LANDSCAPE.mp4' | asset_url }}"
      data-portrait-src="{{ 'videos/PORTRAIT.mp4' | asset_url }}"
      loop 
      playsinline 
      muted 
      autoplay
      preload="metadata"
    >
      Your browser does not support HTML5 video.
    </video>
  </div>

  <!-- Projector Light Beam radiating onto the screen -->
  <div class="s1-projector-beam"></div>

  <!-- Hand-carved bamboo / wooden screen frame overlay -->
  <div class="s1-layer-frame"></div>

  <!-- Foreground layer: film projector, pineapple projectionist, marshmallow beanbag seats & palm trees -->
  <div class="s1-layer-fg" id="s1LayerFg"></div>

  <!-- Interactive Cinema Controls -->
  <div class="s1-controls-bar">
    <button type="button" class="btn-cartoon btn-cartoon-yellow" id="btnPlayVideo" style="background-color: var(--color-yellow-accent); color: var(--color-purple-deep); padding: 7px 18px; font-size: 0.92rem;">
      ⏸ PAUSE FILM
    </button>
    <button type="button" class="btn-cartoon btn-cartoon-teal" id="btnMuteVideo" style="padding: 7px 18px; font-size: 0.92rem;">
      🔇 UNMUTE
    </button>
  </div>

  <div class="s1-scroll-cue" onclick="document.getElementById('enchanted-forest').scrollIntoView({behavior: 'smooth'})">
    <span>Scroll to 3D Book</span>
    <span>↓</span>
  </div>
</section>

{% schema %}
{
  "name": "Cartoon Cinema",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Suburban Jungle Cinema"
    }
  ]
}
{% endschema %}
